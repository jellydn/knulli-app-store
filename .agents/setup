#!/bin/sh
set -eu

go_version=1.27.3
install_go=true
if command -v go >/dev/null 2>&1 && command -v gofmt >/dev/null 2>&1; then
  current_version=$(go version | awk '{ sub(/^go/, "", $3); print $3 }')
  # Match CI's analyzer-compatible toolchain, not just the module minimum.
  if [ "$current_version" = "$go_version" ]; then
    install_go=false
  fi
fi

if "$install_go"; then
  case "$(uname -m)" in
    x86_64)
      go_arch=amd64
      go_sha256=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
      ;;
    aarch64)
      go_arch=arm64
      go_sha256=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
      ;;
    *)
      echo "unsupported architecture for Go setup: $(uname -m)" >&2
      exit 1
      ;;
  esac
  archive=$(mktemp)
  trap 'rm -f "$archive"' EXIT HUP INT TERM
  curl -fsSL "https://go.dev/dl/go${go_version}.linux-${go_arch}.tar.gz" -o "$archive"
  echo "$go_sha256  $archive" | sha256sum -c -
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf "$archive"
  sudo ln -sf /usr/local/go/bin/go /usr/local/bin/go
  sudo ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
fi

if ! pkg-config --exists sdl2 SDL2_image SDL2_ttf SDL2_gfx 2>/dev/null; then
  sudo apt-get update -qq
  sudo apt-get install -y -qq libsdl2-dev libsdl2-image-dev libsdl2-ttf-dev libsdl2-gfx-dev
fi

go version
go mod download
